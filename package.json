{
  "name": "on-device-llm-rn",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal React Native + Expo demo running a private LLM fully on-device (offline, zero-cloud) with llama.rn. Proof asset for edge-AI-on-mobile work.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "expo": "~54.0.35",
    "expo-file-system": "~19.0.23",
    "expo-status-bar": "~3.0.9",
    "llama.rn": "0.12.5",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.11",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
